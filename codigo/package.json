{
  "name": "reequilibra-forum",
  "version": "1.0.0",
  "description": "Forum de saúde mental com memories privados",
  "main": "server.js",
  "scripts": {
    "start": "json-server --watch ./db/db.json --port 3000 --static public/modulos/forum/index.html",
    "dev": "concurrently \"json-server --watch db.json --port 3001\" \"live-server --port=3000\"",
    "json-server": "json-server --watch db.json --port 3001"
  },
  "dependencies": {
    "json-server": "^0.17.4",
    "concurrently": "^8.2.2"
  },
  "devDependencies": {
    "live-server": "^1.2.2"
  }
}
